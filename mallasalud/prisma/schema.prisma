datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Especialidad {
  MEDICINA_GENERAL
  DENTAL
  MATRONERIA
}

enum EstadoBloque {
  DISPONIBLE
  BLOQUEO_TEMPORAL
  RESERVADO
  BLOQUEADO_SOME
}

enum EstadoCita {
  AGENDADA
  CANCELADA_OPORTUNA
  ATENDIDA
  NO_ASISTE
}

enum CanalOrigen {
  WEB
  VOZ_IVR
  VENTANILLA_SOME
}

model Paciente {
  id                    String    @id @default(uuid())
  rut                   String    @unique
  nombres               String
  apellidos             String
  fecha_nacimiento      DateTime  @map("fecha_nacimiento")
  telefono              String
  estado_inscripcion    Boolean   @default(true) @map("estado_inscripcion")
  contador_inasistencias Int      @default(0) @map("contador_inasistencias")
  created_at            DateTime  @default(now()) @map("created_at")

  citas                 Cita[]

  @@map("pacientes")
}

model Profesional {
  id           String        @id @default(uuid())
  rut          String        @unique
  nombres      String
  apellidos    String
  especialidad Especialidad
  activo       Boolean       @default(true)

  agendas      AgendaMedica[]
  citas        Cita[]

  @@map("profesionales")
}

model Box {
  id           String        @id @default(uuid())
  numero       String        @unique
  especialidad Especialidad
  activo       Boolean       @default(true)

  agendas      AgendaMedica[]

  @@map("boxes")
}

model AgendaMedica {
  id                  String         @id @default(uuid())
  profesional_id      String         @map("profesional_id")
  box_id              String         @map("box_id")
  especialidad        Especialidad
  fecha               DateTime
  hora_inicio         String         @map("hora_inicio")
  hora_fin            String         @map("hora_fin")
  duracion_bloque_min Int            @map("duracion_bloque_min")
  activa              Boolean        @default(true)
  created_at          DateTime       @default(now()) @map("created_at")

  profesional         Profesional    @relation(fields: [profesional_id], references: [id])
  box                 Box            @relation(fields: [box_id], references: [id])
  bloques             BloqueHorario[]

  @@index([profesional_id])
  @@index([box_id])
  @@index([fecha, especialidad])
  @@map("agendas_medicas")
}

model BloqueHorario {
  id                    String        @id @default(uuid())
  agenda_id             String        @map("agenda_id")
  hora_inicio           DateTime      @map("hora_inicio")
  hora_fin              DateTime      @map("hora_fin")
  estado_bloque         EstadoBloque  @default(DISPONIBLE) @map("estado_bloque")
  es_cuota_adulto_mayor Boolean       @default(false) @map("es_cuota_adulto_mayor")
  bloqueado_hasta       DateTime?     @map("bloqueado_hasta")
  bloqueado_por_rut     String?       @map("bloqueado_por_rut")

  agenda                AgendaMedica  @relation(fields: [agenda_id], references: [id], onDelete: Cascade)
  cita                  Cita?

  @@index([agenda_id, estado_bloque])
  @@index([hora_inicio, hora_fin])
  @@index([estado_bloque, es_cuota_adulto_mayor])
  @@map("bloques_horarios")
}

model Cita {
  id             String        @id @default(uuid())
  codigo_reserva String        @unique @map("codigo_reserva")
  paciente_id    String        @map("paciente_id")
  profesional_id String        @map("profesional_id")
  bloque_id      String        @unique @map("bloque_id")
  especialidad   Especialidad
  estado_cita    EstadoCita    @default(AGENDADA) @map("estado_cita")
  canal_origen   CanalOrigen   @map("canal_origen")
  hora_atencion  DateTime?     @map("hora_atencion")
  created_at     DateTime      @default(now()) @map("created_at")

  paciente       Paciente      @relation(fields: [paciente_id], references: [id])
  profesional    Profesional   @relation(fields: [profesional_id], references: [id])
  bloque         BloqueHorario @relation(fields: [bloque_id], references: [id])
  registro_sms   RegistroSms[]

  @@index([paciente_id])
  @@index([profesional_id])
  @@index([estado_cita])
  @@map("citas")
}

model RegistroSms {
  id                 String    @id @default(uuid())
  cita_id            String    @map("cita_id")
  telefono_destino   String    @map("telefono_destino")
  cuerpo_mensaje     String    @map("cuerpo_mensaje")
  longitud_caracteres Int      @map("longitud_caracteres")
  estado_envio       String    @map("estado_envio")
  timestamp          DateTime  @default(now())

  cita               Cita      @relation(fields: [cita_id], references: [id], onDelete: Cascade)

  @@index([cita_id])
  @@map("registro_sms")
}