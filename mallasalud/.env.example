# ====================================================================
# CONFIGURACIÓN DE BASE DE DATOS POSTGRESQL (DOCKER Y LOCAL)
# ====================================================================
DB_USER=postgres
DB_PASSWORD=mallasalud_password
DB_NAME=mallasalud_db
DB_PORT=5433
PORT=3000
STUDIO_PORT=5555

# URL de conexión Prisma cuando ejecutas comandos fuera de Docker
DATABASE_URL="postgresql://postgres:mallasalud_password@localhost:5433/mallasalud_db?schema=public"

# ====================================================================
# SEGURIDAD RBAC / SESIONES INTRANET (RECOMENDADO CAMBIAR EN NUBE)
# ====================================================================
SESSION_SECRET="cambia-este-secreto-hmac-sha256-en-produccion"

# ====================================================================
# TELEFONÍA CLOUD Y SMS (CANAL VOZ_IVR) - OPCIONAL EN MODO DEMO WEB
# ====================================================================
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+1XXXXXXXXXX"
DEFAULT_TO_NUMBER="+569XXXXXXXX"
TWILIO_VOICE_NAME="Polly.Mia-Neural"
TWILIO_VOICE_LANGUAGE="es-MX"
TWILIO_SMS_ENABLED="true"
TWILIO_TRIAL_SMS_TEMPLATE="sms_appointment_reminders"
# Opcional para el enlace telefonico visible en el footer del portal web:
NEXT_PUBLIC_TWILIO_PHONE=""

# Opcional: en Docker local se autodetecta el túnel Cloudflare del contenedor `tunnel`.
# En Railway / VPS configura tu dominio HTTPS permanente:
# PUBLIC_WEBHOOK_BASE_URL="https://tu-dominio-en-la-nube.up.railway.app"

# ====================================================================
# MOTOR CONVERSACIONAL IA (OPCIONAL - TIENE FALLBACK NLU LOCAL <10ms)
# ====================================================================
# Una o múltiples claves Gemini separadas por coma:
GEMINI_API_KEYS=""
